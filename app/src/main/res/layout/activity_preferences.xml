            <LinearLayout
                android:id="@+id/cardTrainingSplit"
                android:background="@drawable/bg_preference_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Tipo de rutina"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageButton
                        android:id="@+id/btnEditTrainingSplit"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/tvTrainingSplitValue"
                    android:background="@drawable/bg_chip_blue"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Sin definir"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTrainingObjective"
                android:background="@drawable/bg_preference_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Objetivo de entrenamiento"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageButton
                        android:id="@+id/btnEditTrainingObjective"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/tvTrainingObjectiveValue"
                    android:background="@drawable/bg_chip_blue"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Sin definir"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTrainingLimitations"
                android:background="@drawable/bg_preference_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Limitaciones / lesiones"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageButton
                        android:id="@+id/btnEditTrainingLimitations"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/tvTrainingLimitationsValue"
                    android:background="@drawable/bg_chip_blue"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Ninguna"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSedentaryNotifications"
                android:background="@drawable/bg_preference_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Notificaciones de sedentarismo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageButton
                        android:id="@+id/btnEditSedentaryNotifications"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/tvSedentaryNotificationsValue"
                    android:background="@drawable/bg_chip_blue"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Desactivadas"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:text="Fuente de pasos"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageButton
                        android:id="@+id/btnEditSedentarySource"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar fuente de pasos"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/tvSedentarySourceValue"
                    android:background="@drawable/bg_chip_blue"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:text="No aplica"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Health Connect integra reloj y otras apps. El sensor del móvil no requiere apps externas, pero solo cuenta pasos llevando el teléfono."
                    android:textColor="@color/dark_gray"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnTestSedentaryNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/primary"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Probar aviso ahora"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSavePreferences"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/inter_bold"
        android:text="Guardar cambios"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="16sp"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemIconTint="@color/nav_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu_galifit" />

</androidx.constraintlayout.widget.ConstraintLayout>
